# Local Docker Postgres (docker compose up -d). For Vercel, paste the Neon/Vercel Postgres URL.
DATABASE_URL="postgresql://parsu:parsu_local_dev@localhost:5433/parsu_dashboard?schema=public"

# Session signing secret — generate a long random string for production
AUTH_SECRET="replace-with-a-long-random-secret"

# Bootstrap the first administrator (used by npm run bootstrap:admin and seed)
ADMIN_EMAIL="admin@parsu.edu.ph"
ADMIN_PASSWORD="change-this-password"

# Public site
NEXT_PUBLIC_SITE_NAME="Partido State University Executive Dashboard"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cookie security (set to true in production with HTTPS)
AUTH_COOKIE_SECURE="false"

# Optional: path to the source workbook for the initial import
EXCEL_SOURCE_PATH="./Executive-Dashboard.xlsx"

# Optional: AI for the public dashboard chatbot. GEMINI_API_KEY is preferred when set.
# If no AI key is set, answers still use published dashboard figures.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.1-flash-lite"
# OPENAI_API_KEY="sk-..."
# GROQ_API_KEY="gsk_..."
# AI_GATEWAY_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# CHAT_MODEL="gpt-4o-mini"
